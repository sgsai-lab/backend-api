import enum
import uuid

from sqlalchemy import ForeignKey, Index, String, Text, text
from sqlalchemy.dialects.postgresql import ARRAY
from sqlalchemy.orm import Mapped, mapped_column

from app.db.base import Base
from app.db.mixins import SoftDelete, Timestamps, UUIDPrimaryKey


class WidgetStatus(enum.StrEnum):
    DRAFT = "draft"
    ACTIVE = "active"
    ARCHIVED = "archived"


class Widget(UUIDPrimaryKey, Timestamps, SoftDelete, Base):
    __tablename__ = "widgets"
    __table_args__ = (
        Index(
            "uq_widgets_owner_id_name_active",
            "owner_id",
            "name",
            unique=True,
            postgresql_where=text("deleted_at IS NULL"),
        ),
        Index("ix_widgets_tags", "tags", postgresql_using="gin"),
    )

    owner_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("users.id", ondelete="CASCADE"), index=True
    )
    name: Mapped[str] = mapped_column(String(120))
    description: Mapped[str | None] = mapped_column(Text)
    status: Mapped[WidgetStatus] = mapped_column(
        default=WidgetStatus.DRAFT, server_default=WidgetStatus.DRAFT.value
    )
    tags: Mapped[list[str]] = mapped_column(ARRAY(String(32)), server_default="{}")
