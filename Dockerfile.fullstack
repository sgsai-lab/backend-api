# syntax=docker/dockerfile:1.7
# Single image bundling the API (uvicorn :8000), the webapp (nginx :8080) and the
# contact server (node :3000). Only nginx is exposed; it proxies /api/v1 to the API.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS web-builder
WORKDIR /web
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
RUN npm run build && npm prune --omit=dev

FROM ${PYTHON_IMAGE} AS api-builder
COPY --from=ghcr.io/astral-sh/uv:0.11@sha256:77280f2f771df71f90786c314fe1bbc1e023feac652969bbf139c280babf2eb7 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

FROM ${PYTHON_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled /etc/nginx/conf.d/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home app \
    && ln -sf /dev/stderr /var/log/nginx/error.log \
    && chown -R 10001:10001 /var/lib/nginx /var/log/nginx
COPY docker/fullstack/nginx.conf /etc/nginx/nginx.conf
RUN --mount=type=bind,source=webapp/nginx.conf,target=/tmp/site.conf \
    sed 's|\${API_UPSTREAM}|http://127.0.0.1:8000|g' /tmp/site.conf > /etc/nginx/conf.d/default.conf
COPY --from=web-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=web-builder /web/dist/ /usr/share/nginx/html/
COPY --from=web-builder /web/server.mjs /app/webapp/server.mjs
COPY --from=web-builder /web/node_modules/ /app/webapp/node_modules/

WORKDIR /app
COPY --from=api-builder /app/.venv /app/.venv
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./
COPY --chmod=755 docker/fullstack/entrypoint.sh /usr/local/bin/entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
USER 10001
EXPOSE 8080
CMD ["/usr/local/bin/entrypoint.sh"]
