# Copy to .env for local development. Never commit .env.

# local | test | development | staging | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = JSON logs (Cloud Logging); false = human-readable console logs
LOG_JSON=false
# Cloud Run injects PORT=8080
PORT=8080

# Async SQLAlchemy URL (asyncpg driver). In GCP this comes from Secret Manager.
# Compose publishes Postgres on host port 5433 (override with DB_HOST_PORT)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app
# Keep (max-instances x DB_POOL_SIZE) below the Cloud SQL connection limit
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0

# JSON list of allowed browser origins
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Base URL used in emailed links (verify email, reset password, invites)
FRONTEND_BASE_URL=http://localhost:3000
# Max request body in bytes (413 above this)
MAX_REQUEST_BODY_BYTES=1048576
# Set in GCP so logs correlate with Cloud Trace
# GCP_PROJECT_ID=my-project
# Cloud Run + Cloud SQL socket form:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Auth tokens (ADR-001) ---
# EC P-256 private key (PEM). Required outside local/test; locally an ephemeral key is generated.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_KEY_ID=local-1
# During key rotation, keep the previous public key so existing tokens stay valid
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=sgsai-backend-api
JWT_AUDIENCE=sgsai-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90

# --- MFA ---
# Fernet key encrypting TOTP secrets. Required outside local/test.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=
MFA_ISSUER=SGS AI
# Feature flag: allow users to enrol in TOTP MFA (users already enrolled are always challenged)
MFA_ENABLED=true
# Feature flag: admin endpoints require a session that passed MFA (turn on for production)
ADMIN_REQUIRE_MFA=false

# --- Google sign-in: JSON list of OAuth client IDs (web, Android, iOS) ---
GOOGLE_OAUTH_CLIENT_IDS=[]
# Webapp: public web client ID rendered as the Google button (must also be listed above)
GOOGLE_CLIENT_ID=

# --- Sign in with Apple: JSON list of Services IDs (web) / bundle IDs (iOS) accepted as audience ---
APPLE_CLIENT_IDS=[]
# Webapp: Services ID for the Apple button (needs an HTTPS domain + return URL registered with Apple)
APPLE_CLIENT_ID=

# --- Firebase Auth (mobile ID tokens) ---
# One project per backend environment; verification uses Application Default Credentials.
# FIREBASE_PROJECT_ID=sgsai-dev

# --- Email ---
# smtp (Mailpit locally) | api (SendGrid in GCP) | memory (tests)
EMAIL_BACKEND=smtp
EMAIL_FROM=SGS AI <no-reply@sgsai.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_START_TLS=false
# EMAIL_API_KEY=
EMAIL_TIMEOUT_SECONDS=5

# In-memory per instance until API-16 adds Redis
RATE_LIMIT_ENABLED=true
